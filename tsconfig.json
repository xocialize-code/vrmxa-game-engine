{
  // Type-checks the engine's plain JavaScript through JSDoc (no build step, nothing emitted).
  // Packages' src/ only; tests and spikes are not checked.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["engine/packages/*/src/**/*.js"],
  "exclude": ["engine/packages/*/src/vendor/**"]
}
