{
  "name": "@vrmxg/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "The VRMXG MCP server: describe node types from the registry, edit a .vrmxs scene with undo, and inspect and drive it, in a headless engine or in the open VRMXG editor (edits through its undo, its play world, screenshots).",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./tools": "./src/tools.js",
    "./live": "./src/live.js"
  },
  "bin": {
    "vrmxg-mcp": "./src/server.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vrmxg/audio": "0.1.0",
    "@vrmxg/camera": "0.1.0",
    "@vrmxg/character": "0.1.0",
    "@vrmxg/closet": "0.1.0",
    "@vrmxg/core": "0.1.0",
    "@vrmxg/dmath": "0.1.0",
    "@vrmxg/input": "0.1.0",
    "@vrmxg/interact": "0.1.0",
    "@vrmxg/item": "0.1.0",
    "@vrmxg/model": "0.1.0",
    "@vrmxg/physics": "0.1.0",
    "@vrmxg/registry": "0.1.0",
    "@vrmxg/scene": "0.1.0",
    "@vrmxg/tracks": "0.1.0",
    "@vrmxg/voice": "0.1.0",
    "three": "0.187.0"
  }
}
