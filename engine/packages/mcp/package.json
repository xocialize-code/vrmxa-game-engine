  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vrmxg/camera": "0.1.0",
    "@vrmxg/character": "0.1.0",
    "@vrmxg/core": "0.1.0",
    "@vrmxg/dmath": "0.1.0",
    "@vrmxg/input": "0.1.0",
    "@vrmxg/physics": "0.1.0",
    "@vrmxg/registry": "0.1.0",
    "@vrmxg/scene": "0.1.0",
    "three": "0.187.0"
  }
}
