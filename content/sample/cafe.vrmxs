  ],
  "nodes": [
    {"id":"root","type":"Node3D","name":"Cafe"},
    {"id":"env","type":"Environment","parent":"root","props":{"ambientIntensity":0.5,"background":"gradient","environmentIntensity":0.35,"skyHorizonColor":"#e6ecf2","skyTopColor":"#7aa6d6"}},
    {"id":"set","type":"Model","parent":"root","asset":"cafe"},
    {"id":"espresso","type":"Model","parent":"root","name":"Espresso machine","asset":"espresso","transform":{"p":[1.2,1.25,-4.3]},"props":{"colliders":"none"}},
    {"id":"sun","type":"DirectionalLight","parent":"root","transform":{"q":[-0.354,0.354,0.146,0.854]},"props":{"intensity":2.4,"shadowExtent":10,"shadowPreset":"high"}},
    {"id":"counter-light","type":"SpotLight","parent":"root","transform":{"p":[0,2.9,-3.2],"q":[-0.643,0,0,0.766]},"props":{"angle":40,"color":"#ffe2b0","intensity":18,"range":7}},
    {"id":"door-1","type":"Item","parent":"root","name":"Staff door","asset":"cafe-door","transform":{"p":[6.1,0,-3],"q":[0,0.7071068,0,0.7071068]},"props":{"state":"locked"}},
    {"id":"entrance-left","type":"Item","parent":"root","name":"Entrance (left)","asset":"cafe-door","transform":{"p":[-0.5,0,6.1]}},
    {"id":"entrance-right","type":"Item","parent":"root","name":"Entrance (right)","asset":"cafe-door","transform":{"p":[0.5,0,6.1],"q":[0,1,0,0]}},
    {"id":"spawn","type":"Marker","parent":"root","transform":{"p":[-0.5,0,9.5]},"props":{"purpose":"spawn"}},
    {"id":"mira","type":"Character","parent":"root","name":"Mira","asset":"mira","transform":{"p":[-0.5,0,9.5],"q":[0,1,0,0]},"behaviours":[{"use":"player"}]},
    {"id":"hana-1","type":"Character","parent":"root","name":"Hana","asset":"hana","transform":{"p":[-1.5,0,-3]},"props":{"controller":"npc"},"behaviours":[{"radius":1.5,"use":"wander"}]},
    {"id":"cam","type":"Camera","parent":"root","transform":{"p":[-0.5,1.6,12.5]},"props":{"focalLength":30,"preset":"follow","rig":{"yaw":180},"target":"mira"}}
