  "connections": [
    {"from":"door-1","signal":"ready","to":"hana-1","call":"lookAt","args":{"target":"mira"}},
    {"from":"entrance-left","signal":"entered","to":"entrance-left","call":"enterState","args":{"state":"open"}},
    {"from":"entrance-left","signal":"exited","to":"entrance-left","call":"enterState","args":{"state":"closed"}},
    {"from":"entrance-right","signal":"entered","to":"entrance-right","call":"enterState","args":{"state":"open"}},
    {"from":"entrance-right","signal":"exited","to":"entrance-right","call":"enterState","args":{"state":"closed"}}
