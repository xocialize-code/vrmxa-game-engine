     "timeout": 40
    }
   },
   {
    "type": "action",
    "do": "goTo",
    "args": {
     "point": "$inside",
     "timeout": 40
    }
   },
   {
    "type": "action",
    "do": "goTo",
    "args": {
     "point": "$entry",
     "timeout": 40
    }
   },
   {
    "type": "action",
    "do": "goTo",
    "args": {
