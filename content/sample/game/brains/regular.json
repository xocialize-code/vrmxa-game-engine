    "name": "served",
    "timeout": 900
   },
   {
    "type": "selector",
    "children": [
     {
      "type": "sequence",
      "children": [
       {
        "type": "condition",
        "test": "bb",
        "key": "goal.params.right"
       },
       {
        "type": "action",
        "do": "emote",
        "args": {
         "name": "happy"
        }
       },
       {
        "type": "action",
        "do": "gesture",
        "args": {
         "slot": "cheer"
        }
       }
      ]
     },
     {
      "type": "action",
      "do": "emote",
      "args": {
       "name": "sad"
      }
     }
    ]
   },
   {
    "type": "action",
    "do": "lookAt",
    "args": {}
   },
   {
    "type": "set",
    "key": "served",
    "value": true
   },
   {
    "type": "repeat",
    "child": {
     "type": "sequence",
     "children": [
      {
       "type": "action",
       "do": "gesture",
       "args": {
        "slot": "sip"
       }
      },
      {
       "type": "action",
       "do": "wait",
       "args": {
