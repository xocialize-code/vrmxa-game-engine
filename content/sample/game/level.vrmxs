    {"id":"cafe-door","type":"vrmxi","ref":"items/cafe-door.vrmxi"},
    {"id":"stool","type":"vrmxi","ref":"items/stool.vrmxi"},
    {"id":"till","type":"vrmxi","ref":"game/items/till.vrmxi"},
    {"id":"order-1","type":"vrmxi","ref":"game/items/order-1.vrmxi"},
    {"id":"order-2","type":"vrmxi","ref":"game/items/order-2.vrmxi"},
    {"id":"order-3","type":"vrmxi","ref":"game/items/order-3.vrmxi"},
    {"id":"ambience","type":"audio","ref":"sounds/cafe-ambience.wav"},
    {"id":"music","type":"audio","ref":"sounds/music.wav"}
  ],
  "nodes": [
    {"id":"root","type":"Node3D","name":"Level"},
    {"id":"env","type":"Environment","parent":"root","props":{"ambientIntensity":0.5,"background":"gradient","environmentIntensity":0.35,"skyHorizonColor":"#e6ecf2","skyTopColor":"#7aa6d6"}},
    {"id":"set","type":"Model","parent":"root","asset":"cafe"},
    {"id":"espresso","type":"Model","parent":"root","name":"Espresso machine","asset":"espresso","transform":{"p":[1.2,1.25,-4.3]},"props":{"colliders":"none"}},
    {"id":"sun","type":"DirectionalLight","parent":"root","transform":{"q":[-0.354,0.354,0.146,0.854]},"props":{"intensity":2.4,"shadowExtent":10,"shadowPreset":"high"}},
    {"id":"counter-light","type":"SpotLight","parent":"root","transform":{"p":[0,2.9,-3.2],"q":[-0.643,0,0,0.766]},"props":{"angle":40,"color":"#ffe2b0","intensity":18,"range":7}},
    {"id":"ambience","type":"AudioPlayer","parent":"root","name":"Room tone","asset":"ambience","props":{"autoplay":true,"bus":"ambience","loop":true,"volume":0.6}},
    {"id":"music","type":"AudioPlayer","parent":"root","name":"Music","asset":"music","props":{"autoplay":true,"bus":"music","loop":true,"volume":0.35}},
    {"id":"entrance-left","type":"Item","parent":"root","name":"Entrance (left)","asset":"cafe-door","transform":{"p":[-0.5,0,6.1]},"props":{"state":"open"}},
    {"id":"entrance-right","type":"Item","parent":"root","name":"Entrance (right)","asset":"cafe-door","transform":{"p":[0.5,0,6.1],"q":[0,1,0,0]},"props":{"state":"open"}},
    {"id":"door-staff","type":"Item","parent":"root","name":"Staff door","asset":"cafe-door","transform":{"p":[6.1,0,-3],"q":[0,0.7071068,0,0.7071068]},"props":{"state":"locked"}},
    {"id":"stool-1","type":"Item","parent":"root","name":"Stool","asset":"stool","transform":{"p":[-3.75,0,1],"q":[0,0.7071068,0,0.7071068]}},
    {"id":"stool-2","type":"Item","parent":"root","name":"Stool","asset":"stool","transform":{"p":[-2.25,0,1],"q":[0,-0.7071068,0,0.7071068]}},
    {"id":"stool-3","type":"Item","parent":"root","name":"Stool","asset":"stool","transform":{"p":[2.25,0,1],"q":[0,0.7071068,0,0.7071068]}},
    {"id":"stool-4","type":"Item","parent":"root","name":"Stool","asset":"stool","transform":{"p":[3.75,0,1],"q":[0,-0.7071068,0,0.7071068]}},
    {"id":"stool-5","type":"Item","parent":"root","name":"Stool","asset":"stool","transform":{"p":[2.25,0,-2],"q":[0,0.7071068,0,0.7071068]}},
    {"id":"stool-6","type":"Item","parent":"root","name":"Stool","asset":"stool","transform":{"p":[3.75,0,-2],"q":[0,-0.7071068,0,0.7071068]}},
    {"id":"stool-7","type":"Item","parent":"root","name":"Stool","asset":"stool","transform":{"p":[-3.75,0,-2.2],"q":[0,0.7071068,0,0.7071068]}},
    {"id":"stool-8","type":"Item","parent":"root","name":"Stool","asset":"stool","transform":{"p":[-2.25,0,-2.2],"q":[0,-0.7071068,0,0.7071068]}},
    {"id":"till","type":"Item","parent":"root","name":"Till","asset":"till","transform":{"p":[-1.65,1.06,-3.95]},"props":{"state":"locked"}},
    {"id":"tray-1","type":"Item","parent":"root","name":"Order for table 1","asset":"order-1","transform":{"p":[-0.9,1.06,-3.95]},"props":{"state":"waiting"}},
    {"id":"tray-2","type":"Item","parent":"root","name":"Order for table 2","asset":"order-2","transform":{"p":[-0.1,1.06,-3.95]},"props":{"state":"waiting"}},
    {"id":"tray-3","type":"Item","parent":"root","name":"Order for table 3","asset":"order-3","transform":{"p":[0.6,1.06,-3.95]},"props":{"state":"waiting"}},
    {"id":"mira","type":"Character","parent":"root","name":"Mira","asset":"mira","transform":{"p":[-0.4,0,-2.9]},"behaviours":[{"use":"player"}]},
    {"id":"hana-1","type":"Character","parent":"root","name":"Hana","asset":"hana","transform":{"p":[0.6,0,-4.95]},"props":{"controller":"npc"}},
    {"id":"aoi","type":"Character","parent":"root","name":"Aoi","asset":"hana","transform":{"p":[-1.6,0,9],"q":[0,1,0,0]},"props":{"controller":"npc"},"behaviours":[{"preset":"game/brains/regular.json","use":"brain","vars":{"arrive":8,"seat":"stool-2"}}]},
    {"id":"ren","type":"Character","parent":"root","name":"Ren","asset":"hana","transform":{"p":[-1,0,9.8],"q":[0,1,0,0]},"props":{"controller":"npc"},"behaviours":[{"preset":"game/brains/regular.json","use":"brain","vars":{"arrive":35,"seat":"stool-3"}}]},
    {"id":"yuki","type":"Character","parent":"root","name":"Yuki","asset":"hana","transform":{"p":[-0.3,0,10.5],"q":[0,1,0,0]},"props":{"controller":"npc"},"behaviours":[{"preset":"game/brains/regular.json","use":"brain","vars":{"arrive":60,"seat":"stool-5"}}]},
    {"id":"look-at","type":"Marker","parent":"root","transform":{"p":[0,0,-0.8]}},
    {"id":"cam","type":"Camera","parent":"root","transform":{"p":[0,8.2,8.6]},"props":{"focalLength":24,"preset":"fixed","target":"look-at"}},
    {"id":"table-1","type":"Area","parent":"root","name":"Table 1","transform":{"p":[-1.45,1,1]},"props":{"shape":"box","size":[1.1,2,1.8]},"behaviours":[{"customer":"aoi","dialogue":"order-1","item":"6f1c2a3e-4b5d-4e6f-8a7b-1c2d3e4f5a61","ordered":"ordered1","player":"mira","points":10,"right":"right1","use":"tableZone"}]},
    {"id":"table-2","type":"Area","parent":"root","name":"Table 2","transform":{"p":[1.45,1,1]},"props":{"shape":"box","size":[1.1,2,1.8]},"behaviours":[{"customer":"ren","dialogue":"order-2","item":"6f1c2a3e-4b5d-4e6f-8a7b-1c2d3e4f5a62","ordered":"ordered2","player":"mira","points":10,"right":"right2","use":"tableZone"}]},
    {"id":"table-3","type":"Area","parent":"root","name":"Table 3","transform":{"p":[1.45,1,-2]},"props":{"shape":"box","size":[1.1,2,1.8]},"behaviours":[{"customer":"yuki","dialogue":"order-3","item":"6f1c2a3e-4b5d-4e6f-8a7b-1c2d3e4f5a63","ordered":"ordered3","player":"mira","points":10,"right":"right3","use":"tableZone"}]},
    {"id":"rules","type":"GameRules","parent":"root","props":{"flags":{"ordered1":false,"ordered2":false,"ordered3":false,"right1":false,"right2":false,"right3":false,"tillClosed":false},"lose":{"of":[{"key":"timers.clock.done","test":"state"},{"key":"counters.mistakes","op":"ge","test":"state","value":2}],"test":"any"}}},
    {"id":"score","type":"GameCounter","parent":"rules","props":{"label":"Score"}},
    {"id":"served","type":"GameCounter","parent":"rules","props":{"label":"Served","max":3}},
    {"id":"mistakes","type":"GameCounter","parent":"rules","props":{"label":"Wrong orders"}},
    {"id":"clock","type":"GameTimer","parent":"rules","props":{"label":"Until ten o'clock","seconds":240}},
    {"id":"brew-1","type":"GameTimer","parent":"rules","props":{"autostart":false,"seconds":6}},
    {"id":"brew-2","type":"GameTimer","parent":"rules","props":{"autostart":false,"seconds":6}},
    {"id":"brew-3","type":"GameTimer","parent":"rules","props":{"autostart":false,"seconds":6}},
    {"id":"serve","type":"GameGoal","parent":"rules","props":{"text":"Serve the three regulars","when":{"key":"counters.served","op":"ge","test":"state","value":3}}},
    {"id":"close-till","type":"GameGoal","parent":"rules","props":{"text":"Close the till","when":{"key":"flags.tillClosed","test":"state"}}},
    {"id":"cp-first","type":"Checkpoint","parent":"rules","props":{"label":"First order served","once":true,"slot":"first-order","when":{"key":"counters.served","op":"ge","test":"state","value":1}}},
    {"id":"briefing","type":"Dialogue","parent":"root","props":{"autostart":true,"lines":[{"choices":[{"id":"ready","text":"On it!","to":"ready"},{"id":"coffee","text":"Coffee first?","to":"coffee"}],"clip":"game/voice/hana-brief.wav","speaker":"hana-1","text":"Morning, Mira! Three regulars are due. Take their orders, bring each one what I make, and close the till before ten."},{"clip":"game/voice/hana-brief-ready.wav","id":"ready","next":"end","speaker":"hana-1","text":"That's the spirit. Here comes Aoi!"},{"clip":"game/voice/hana-brief-coffee.wav","id":"coffee","speaker":"hana-1","text":"After the rush! Here comes Aoi."}]}},
    {"id":"order-1","type":"Dialogue","parent":"root","name":"Aoi's order","props":{"lines":[{"choices":[{"id":"latte","set":{"ordered1":true,"right1":true},"text":"A latte, then.","to":"right"},{"id":"espresso","set":{"ordered1":true,"right1":false},"text":"A double espresso?","to":"wrong"}],"clip":"game/voice/aoi-ask.wav","speaker":"aoi","text":"Morning! Something warm and milky, please. Not too strong."},{"clip":"game/voice/aoi-right.wav","id":"right","next":"end","speaker":"aoi","text":"Perfect. Thank you!"},{"clip":"game/voice/aoi-wrong.wav","id":"wrong","speaker":"aoi","text":"Oh. Well, if you say so."}]}},
    {"id":"order-2","type":"Dialogue","parent":"root","name":"Ren's order","props":{"lines":[{"choices":[{"id":"chocolate","set":{"ordered2":true,"right2":false},"text":"A hot chocolate.","to":"wrong"},{"id":"iced-tea","set":{"ordered2":true,"right2":true},"text":"An iced tea.","to":"right"}],"clip":"game/voice/ren-ask.wav","speaker":"ren","text":"Hi! Something cold, please? It's already warm out."},{"clip":"game/voice/ren-right.wav","id":"right","next":"end","speaker":"ren","text":"Lovely, thanks."},{"clip":"game/voice/ren-wrong.wav","id":"wrong","speaker":"ren","text":"Hot? Hm. All right, then."}]}},
    {"id":"order-3","type":"Dialogue","parent":"root","name":"Yuki's order","props":{"lines":[{"choices":[{"id":"green-tea","set":{"ordered3":true,"right3":true},"text":"Green tea, coming up.","to":"right"},{"id":"coffee","set":{"ordered3":true,"right3":false},"text":"One black coffee.","to":"wrong"}],"clip":"game/voice/yuki-ask.wav","speaker":"yuki","text":"Just a green tea for me, please."},{"clip":"game/voice/yuki-right.wav","id":"right","next":"end","speaker":"yuki","text":"Thank you!"},{"clip":"game/voice/yuki-wrong.wav","id":"wrong","speaker":"yuki","text":"That's not what I said. But fine."}]}}
  ],
  "connections": [
    {"from":"rules","signal":"ready","to":"hana-1","call":"lookAt","args":{"target":"mira"}},
    {"from":"order-1","signal":"chose","to":"brew-1","call":"start"},
    {"from":"order-1","signal":"chose","to":"hana-1","call":"playLayer","args":{"layer":"upperBody","loop":false,"slot":"use"}},
    {"from":"brew-1","signal":"timeout","to":"tray-1","call":"enterState","args":{"state":"ready"}},
    {"from":"brew-1","signal":"timeout","to":"hana-1","call":"say","args":{"clip":"game/voice/hana-up-1.wav","text":"Order up for table one!"}},
    {"from":"order-2","signal":"chose","to":"brew-2","call":"start"},
    {"from":"order-2","signal":"chose","to":"hana-1","call":"playLayer","args":{"layer":"upperBody","loop":false,"slot":"use"}},
    {"from":"brew-2","signal":"timeout","to":"tray-2","call":"enterState","args":{"state":"ready"}},
    {"from":"brew-2","signal":"timeout","to":"hana-1","call":"say","args":{"clip":"game/voice/hana-up-2.wav","text":"Order up for table two!"}},
    {"from":"order-3","signal":"chose","to":"brew-3","call":"start"},
    {"from":"order-3","signal":"chose","to":"hana-1","call":"playLayer","args":{"layer":"upperBody","loop":false,"slot":"use"}},
    {"from":"brew-3","signal":"timeout","to":"tray-3","call":"enterState","args":{"state":"ready"}},
    {"from":"brew-3","signal":"timeout","to":"hana-1","call":"say","args":{"clip":"game/voice/hana-up-3.wav","text":"Order up for table three!"}},
    {"from":"serve","signal":"completed","to":"till","call":"enterState","args":{"state":"open"}},
    {"from":"serve","signal":"completed","to":"hana-1","call":"say","args":{"clip":"game/voice/hana-close.wav","text":"That's everyone! Close the till, Mira."}},
    {"from":"till","signal":"verb","to":"rules","call":"setFlag","args":{"flag":"tillClosed"}},
    {"from":"close-till","signal":"completed","to":"score","call":"add","args":{"by":20}},
    {"from":"rules","signal":"won","to":"rules","call":"changeScene","args":{"after":3,"to":"game/won.vrmxs"}},
    {"from":"rules","signal":"lost","to":"rules","call":"changeScene","args":{"after":3,"to":"game/lost.vrmxs"}}
  ],
  "settings": {
    "physics": {
      "build": "deterministic",
      "hz": 60
    }
  }
}
