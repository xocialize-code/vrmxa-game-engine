    "cast": {"hana-1":{"behaviours":[{"preset":"brains/hana.json","use":"brain"}],"transform":{"p":[0.6,0,-4.6]}},"mira":{"behaviours":[{"preset":"brains/customer.json","use":"brain"}]},"music":{"props":{"autoplay":false}}}
