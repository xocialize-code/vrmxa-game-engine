    {"id":"espresso-steam","type":"ParticleEmitter","name":"Espresso steam","transform":{"p":[1.45,1.3,-3.95]},"props":{"autoplay":false,"effect":"effects/espresso-steam.json"}},
    {"id":"vc-establish","type":"VirtualCamera","name":"The cafe, morning","transform":{"p":[4.6,2.5,3.6]},"props":{"aim":{"damping":0.6,"screen":[0,0.05],"target":"hana-1","type":"composer"},"body":{"type":"fixed"},"lens":{"focalLength":24}}},
    {"id":"vc-door","type":"VirtualCamera","name":"The door, from the counter","transform":{"p":[1.6,1.55,-2.4]},"props":{"aim":{"damping":0.4,"screen":[0,0.08],"target":"mira","type":"composer"},"body":{"type":"fixed"},"lens":{"focalLength":35}}},
    {"id":"vc-hana","type":"VirtualCamera","name":"Hana, close","props":{"aim":{"target":"hana-1"},"body":{"target":"hana-1"},"rig":"closeUp"}},
    {"id":"vc-ots","type":"VirtualCamera","name":"Over Mira's shoulder","props":{"aim":{"target":"hana-1"},"body":{"target":"mira"},"rig":"overShoulder"}},
    {"id":"vc-machine","type":"VirtualCamera","name":"The espresso machine","transform":{"p":[2.5,1.7,-2.7]},"props":{"aim":{"damping":0.3,"eyes":false,"screen":[0,0.05],"target":"espresso-steam","type":"composer"},"body":{"type":"fixed"},"lens":{"focalLength":45}}},
    {"id":"vc-two","type":"VirtualCamera","name":"Two shot","transform":{"p":[1.8,1.5,-1]},"props":{"aim":{"size":0.7,"targets":["mira","hana-1"]},"rig":"twoShot"}}
  ],
  "connections": [],
