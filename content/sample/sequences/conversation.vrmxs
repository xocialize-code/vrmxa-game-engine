      {"id":"mira-says","type":"dialogue","target":"mira","clips":[{"clip":"voice/conversation-mira-says-1.wav","end":280.4,"start":258.8,"text":"Good morning, Hana!"},{"clip":"voice/conversation-mira-says-2.wav","end":520.4,"start":448.4,"text":"I could not sleep. Could I get a latte, please?"},{"clip":"voice/conversation-mira-says-3.wav","end":1320.4,"start":1284.4,"text":"Thank you. It smells wonderful."},{"clip":"voice/conversation-mira-says-4.wav","end":1680.4,"start":1630,"text":"How long have you had this place?"},{"clip":"voice/conversation-mira-says-5.wav","end":2080.4,"start":2030,"text":"Do you ever get a day off?"},{"clip":"voice/conversation-mira-says-6.wav","end":2520.4,"start":2470,"text":"I should get going. See you tomorrow!"}]},
