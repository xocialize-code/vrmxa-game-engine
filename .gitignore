# Reference repos (Godot and others) are read locally, never committed, as in vrmxa-avatar-studio.
reference/

.DS_Store
node_modules/
dist/
build/
mac/build/

# VRM models and clips: the spikes' VRoid samples can't be shipped, and spec.vrm lives in
# xocialize-code/vrmxa-spec. Spikes copy them into public/models/ locally.
**/public/models/
*.vrm
*.vrma

# Rendered video from spike-frame-export
spike-frame-export/out/

# The post check's full-size stills (apps/playground scripts/post-*.mjs; 960-px previews are committed beside them)
apps/playground/results/post/
apps/playground/results/repeat/
# The coverage check's thumbnails, one per shot (scripts/coverage-*; the storyboard strips and the hashes are committed)
apps/playground/results/coverage/

# The sample content's generated CC0 clips are committed (content/sample/LICENCES.md)
!content/sample/animations/clips/*.vrma

# SwiftPM build folders (apps/shell, apps/*-mac)
.build/
__pycache__/

# AB-T-0589 native Metal repro: the built tool and its frame dumps
spike-webgpu-render/repros/metal/machine
spike-webgpu-render/repros/metal/out/
