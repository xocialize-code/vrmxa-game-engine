# Response headers for the documentation's static assets (Workers static assets read this file; it is not served).
# The site is public, but nobody has decided to list it in search engines: remove the X-Robots-Tag line to allow
# indexing.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex

# VitePress names these files by their content's hash, so they never change under a name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The Markdown sources and the indexes are UTF-8. Without the charset a browser opening one directly guesses
# Windows-1252 and garbles every arrow and dash (seen on the first deploy; wrangler dev adds the charset itself).
/*.md
  Content-Type: text/markdown; charset=utf-8
/*.txt
  Content-Type: text/plain; charset=utf-8
