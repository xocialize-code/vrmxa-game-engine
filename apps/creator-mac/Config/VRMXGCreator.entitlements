<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The shell's sandbox (apps/shell): network.server for the loopback origin, user-selected files for the panels. -->
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.network.client</key><true/>
	<key>com.apple.security.network.server</key><true/>
	<key>com.apple.security.files.user-selected.read-write</key><true/>
	<!-- The camera (M4 W9: face takes): the shell's camera.* methods; frames stay in the shell, only the face's shape (numbers) reaches the page. -->
	<key>com.apple.security.device.camera</key><true/>
</dict>
</plist>
