    {"id":"dialogue","type":"Dialogue","parent":"root","transform":{"p":[0,0,1.983371]},"props":{"autostart":true,"lines":[{"choices":[{"id":"ready","text":"On it!","to":"ready"},{"id":"coffee","text":"Coffee first?","to":"coffee"}],"clip":"game/voice/hana-brief.wav","speaker":"hana-1","text":"Morning, Mira! Three regulars are due. Take their orders, bring each one what I make, and close the till before ten."},{"clip":"game/voice/hana-brief-ready.wav","id":"ready","next":"end","speaker":"hana-1","text":"That's the spirit. Here comes Aoi!"},{"clip":"game/voice/hana-brief-coffee.wav","id":"coffee","speaker":"hana-1","text":"After the rush! Here comes Aoi."}]}},
    {"id":"dialogue-2","type":"Dialogue","parent":"root","name":"Aoi's order","transform":{"p":[0,0,1.983371]},"props":{"lines":[{"choices":[{"id":"latte","set":{"ordered1":true,"right1":true},"text":"A latte, then.","to":"right"},{"id":"espresso","set":{"ordered1":true,"right1":false},"text":"A double espresso?","to":"wrong"}],"clip":"game/voice/aoi-ask.wav","speaker":"aoi","text":"Morning! Something warm and milky, please. Not too strong."},{"clip":"game/voice/aoi-right.wav","id":"right","next":"end","speaker":"aoi","text":"Perfect. Thank you!"},{"clip":"game/voice/aoi-wrong.wav","id":"wrong","speaker":"aoi","text":"Oh. Well, if you say so."}]}},
    {"id":"dialogue-3","type":"Dialogue","parent":"root","name":"Ren's order","transform":{"p":[0,0,1.983371]},"props":{"lines":[{"choices":[{"id":"chocolate","set":{"ordered2":true,"right2":false},"text":"A hot chocolate.","to":"wrong"},{"id":"iced-tea","set":{"ordered2":true,"right2":true},"text":"An iced tea.","to":"right"}],"clip":"game/voice/ren-ask.wav","speaker":"ren","text":"Hi! Something cold, please? It's already warm out."},{"clip":"game/voice/ren-right.wav","id":"right","next":"end","speaker":"ren","text":"Lovely, thanks."},{"clip":"game/voice/ren-wrong.wav","id":"wrong","speaker":"ren","text":"Hot? Hm. All right, then."}]}},
    {"id":"dialogue-4","type":"Dialogue","parent":"root","name":"Yuki's order","transform":{"p":[0,0,1.983371]},"props":{"lines":[{"choices":[{"id":"green-tea","set":{"ordered3":true,"right3":true},"text":"Green tea, coming up.","to":"right"},{"id":"coffee","set":{"ordered3":true,"right3":false},"text":"One black coffee.","to":"wrong"}],"clip":"game/voice/yuki-ask.wav","speaker":"yuki","text":"Just a green tea for me, please."},{"clip":"game/voice/yuki-right.wav","id":"right","next":"end","speaker":"yuki","text":"Thank you!"},{"clip":"game/voice/yuki-wrong.wav","id":"wrong","speaker":"yuki","text":"That's not what I said. But fine."}]}}
