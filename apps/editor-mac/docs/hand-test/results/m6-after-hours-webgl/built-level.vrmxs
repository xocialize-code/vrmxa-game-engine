{
  "format": "vrmxs",
  "version": 1,
  "id": "after-hours-level",
  "assets": [
    {"id":"cafe","type":"glb","ref":"sets/cafe.glb"},
    {"id":"back-room","type":"glb","ref":"after-hours/props/back-room.glb"},
    {"id":"cafe-ambience","type":"audio","ref":"sounds/cafe-ambience.wav"},
    {"id":"cafe-door","type":"vrmxi","ref":"items/cafe-door.vrmxi"},
    {"id":"switch","type":"vrmxi","ref":"items/switch.vrmxi"},
    {"id":"shelf","type":"vrmxi","ref":"after-hours/items/shelf.vrmxi"},
    {"id":"scarf","type":"vrmxi","ref":"after-hours/items/scarf.vrmxi"},
    {"id":"phone","type":"vrmxi","ref":"after-hours/items/phone.vrmxi"},
    {"id":"book","type":"vrmxi","ref":"after-hours/items/book.vrmxi"},
    {"id":"mira","type":"vrmxa","ref":"characters/mira.vrmxa"},
    {"id":"hana","type":"vrmxa","ref":"characters/hana.vrmxa"}
  ],
  "nodes": [
    {"id":"root","type":"Node3D","name":"Level"},
    {"id":"env","type":"Environment","parent":"root","props":{"ambientIntensity":0.35,"background":"gradient","environmentIntensity":0.2,"exposure":0.9,"skyHorizonColor":"#3a4258","skyTopColor":"#141a2e"}},
    {"id":"cafe","type":"Model","parent":"root","asset":"cafe"},
    {"id":"back-room","type":"Model","parent":"root","name":"Back room","asset":"back-room"},
    {"id":"moon","type":"DirectionalLight","parent":"root","name":"Moonlight","transform":{"q":[-0.397131,0.309976,0.144544,0.851651]},"props":{"color":"#b9c6ff","intensity":0.7,"shadowExtent":10,"shadowPreset":"high"}},
    {"id":"counter-lamp","type":"SpotLight","parent":"root","name":"Counter lamp","transform":{"p":[0,2.9,-3.2],"q":[-0.642788,0,0,0.766044]},"props":{"angle":40,"color":"#ffd59a","intensity":16,"range":7}},
    {"id":"back-room-bulb","type":"PointLight","parent":"root","name":"Back room bulb","transform":{"p":[7.8,2.5,-3]},"props":{"color":"#ffe2b0","intensity":5,"range":6}},
    {"id":"ambience","type":"AudioPlayer","parent":"root","name":"Room tone","asset":"cafe-ambience","props":{"autoplay":true,"bus":"ambience","loop":true,"volume":0.4}},
    {"id":"front-left","type":"Item","parent":"root","name":"Front door (left)","asset":"cafe-door","transform":{"p":[-0.5,0,6.1]},"props":{"state":"locked"}},
    {"id":"front-right","type":"Item","parent":"root","name":"Front door (right)","asset":"cafe-door","transform":{"p":[0.5,0,6.1],"q":[0,1,0,0]},"props":{"state":"locked"}},
    {"id":"staff-door","type":"Item","parent":"root","name":"Staff door","asset":"cafe-door","transform":{"p":[6.1,0,-3],"q":[0,0.707107,0,0.707107]},"props":{"state":"locked"}},
    {"id":"switch","type":"Item","parent":"root","name":"Back room switch","asset":"switch","transform":{"p":[5.95,0,-4.2],"q":[0,-0.707107,0,0.707107]}},
    {"id":"shelf-coats","type":"Item","parent":"root","name":"Coats and scarves","asset":"shelf","transform":{"p":[-5.82,0,3.5],"q":[0,0.707107,0,0.707107]}},
    {"id":"shelf-phones","type":"Item","parent":"root","name":"Phones and keys","asset":"shelf","transform":{"p":[4.2,0,-5.82]}},
    {"id":"shelf-books","type":"Item","parent":"root","name":"Books","asset":"shelf","transform":{"p":[-5.82,0,-3.2],"q":[0,0.707107,0,0.707107]}},
    {"id":"shelf-store","type":"Item","parent":"root","name":"Store shelf","asset":"shelf","transform":{"p":[8,0,-5.02]}},
    {"id":"scarf","type":"Item","parent":"root","name":"Scarf","asset":"scarf","transform":{"p":[-3,0.775,1],"q":[0,0.258819,0,0.965926]}},
    {"id":"phone","type":"Item","parent":"root","name":"Phone","asset":"phone","transform":{"p":[3,0.775,-2],"q":[0,-0.173648,0,0.984808]}},
    {"id":"book","type":"Item","parent":"root","name":"Book","asset":"book","transform":{"p":[7.75,1.165,-5.02]}},
    {"id":"scarf-shelved","type":"Item","parent":"root","name":"Scarf (on its shelf)","asset":"scarf","transform":{"p":[-5.82,0.615,3.3],"q":[0,0.707107,0,0.707107]},"props":{"state":"away"}},
    {"id":"phone-shelved","type":"Item","parent":"root","name":"Phone (on its shelf)","asset":"phone","transform":{"p":[4.4,0.615,-5.82]},"props":{"state":"away"}},
    {"id":"book-shelved","type":"Item","parent":"root","name":"Book (on its shelf)","asset":"book","transform":{"p":[-5.82,0.615,-3.4],"q":[0,0.707107,0,0.707107]},"props":{"state":"away"}},
    {"id":"mira","type":"Character","parent":"root","name":"Mira","asset":"mira","transform":{"p":[1,0,-2.6]},"behaviours":[{"use":"player"}]},
    {"id":"hana","type":"Character","parent":"root","name":"Hana","asset":"hana","transform":{"p":[0.6,0,-4.95]},"props":{"controller":"npc"}},
    {"id":"look-at","type":"Marker","parent":"root","transform":{"p":[1.6,0,-0.8]}},
    {"id":"cam","type":"Camera","parent":"root","transform":{"p":[1.6,10.5,8.2]},"props":{"focalLength":20,"preset":"fixed","target":"look-at"}},
    {"id":"zone-coats","type":"Area","parent":"root","name":"Coats and scarves (in front)","transform":{"p":[-5.1,1,3.5]},"props":{"shape":"box","size":[0.9,2,1.2]},"behaviours":[{"item":"b2c41d6e-7a3f-4e58-9b10-af7e0a0d0c01","use":"shelf"}]},
    {"id":"zone-phones","type":"Area","parent":"root","name":"Phones and keys (in front)","transform":{"p":[4.2,1,-5.1]},"props":{"shape":"box","size":[1.2,2,0.9]},"behaviours":[{"item":"b2c41d6e-7a3f-4e58-9b10-af7e0a0d0c02","use":"shelf"}]},
    {"id":"zone-books","type":"Area","parent":"root","name":"Books (in front)","transform":{"p":[-5.1,1,-3.2]},"props":{"shape":"box","size":[0.9,2,1.2]},"behaviours":[{"item":"b2c41d6e-7a3f-4e58-9b10-af7e0a0d0c03","use":"shelf"}]},
    {"id":"counter","type":"Area","parent":"root","name":"At the counter","transform":{"p":[-1.2,1,-3.15]},"props":{"shape":"box","size":[1.2,2,0.7]}},
    {"id":"rules","type":"GameRules","parent":"root","props":{"lose":{"of":[{"key":"timers.clock.done","test":"state"},{"key":"counters.mistakes","op":"ge","test":"state","value":2}],"test":"any"}}},
    {"id":"shelved","type":"GameCounter","parent":"rules","props":{"label":"On their shelves","max":3}},
    {"id":"mistakes","type":"GameCounter","parent":"rules","props":{"label":"Wrong shelves"}},
    {"id":"clock","type":"GameTimer","parent":"rules","props":{"label":"Until Hana locks up","seconds":180}},
    {"id":"tidy","type":"GameGoal","parent":"rules","props":{"text":"Put the scarf, the phone and the book on their shelves","when":{"of":[{"key":"counters.shelved","op":"ge","test":"state","value":3},{"key":"counters.mistakes","op":"lt","test":"state","value":2}],"test":"all"}}},
    {"id":"cp-first","type":"Checkpoint","parent":"rules","props":{"label":"First thing on its shelf","once":true,"slot":"first-shelved","when":{"key":"counters.shelved","op":"ge","test":"state","value":1}}},
    {"id":"briefing","type":"Dialogue","parent":"root","name":"Hana's briefing","props":{"autostart":true,"lines":[{"choices":[{"id":"ready","text":"Leave it to me.","to":"ready"},{"id":"how","text":"How do I shelve them?","to":"how"}],"speaker":"hana","text":"That's the last customer gone, and they've left things behind again: a scarf, a phone and a book. Put each one on its shelf before I lock up."},{"id":"ready","next":"end","speaker":"hana","text":"Thanks, Mira. Come to the counter if you want a hint."},{"id":"how","speaker":"hana","text":"Stand at the right shelf and press E. The right shelf, mind!"}]}},
    {"id":"hints","type":"Dialogue","parent":"root","name":"Hana's hints","props":{"lines":[{"choices":[{"id":"scarf","text":"Where does the scarf go?","to":"scarf"},{"id":"phone","text":"And the phone?","to":"phone"},{"id":"book","text":"Where is the book?","to":"book"},{"id":"fine","text":"I'm fine, thanks.","to":"end"}],"speaker":"hana","text":"Need a hand?"},{"id":"scarf","next":"end","speaker":"hana","text":"Scarves and coats go on the shelf by the front door."},{"id":"phone","next":"end","speaker":"hana","text":"Phones by the staff door, where people come and ask for them."},{"id":"book","speaker":"hana","text":"Someone left it in the back room. The switch by the staff door opens it."}]}}
  ],
  "connections": [
    {"from":"rules","signal":"ready","to":"hana","call":"lookAt","args":{"target":"mira"}},
    {"from":"counter","signal":"bodyEntered","to":"hints","call":"start"},
    {"from":"switch","signal":"verb","to":"staff-door","call":"enterState","args":{"state":"open"}},
    {"from":"zone-coats","signal":"placed","to":"shelved","call":"add"},
    {"from":"zone-coats","signal":"placed","to":"scarf-shelved","call":"enterState","args":{"state":"shelved"}},
    {"from":"zone-coats","signal":"refused","to":"mistakes","call":"add"},
    {"from":"zone-coats","signal":"refused","to":"hana","call":"say","args":{"text":"Not on the coat shelf, Mira!"}},
    {"from":"zone-phones","signal":"placed","to":"shelved","call":"add"},
    {"from":"zone-phones","signal":"placed","to":"phone-shelved","call":"enterState","args":{"state":"shelved"}},
    {"from":"zone-phones","signal":"refused","to":"mistakes","call":"add"},
    {"from":"zone-phones","signal":"refused","to":"hana","call":"say","args":{"text":"That doesn't go with the phones."}},
    {"from":"zone-books","signal":"placed","to":"shelved","call":"add"},
    {"from":"zone-books","signal":"placed","to":"book-shelved","call":"enterState","args":{"state":"shelved"}},
    {"from":"zone-books","signal":"refused","to":"mistakes","call":"add"},
    {"from":"zone-books","signal":"refused","to":"hana","call":"say","args":{"text":"The bookshelf is for books!"}},
    {"from":"rules","signal":"won","to":"rules","call":"changeScene","args":{"after":3,"to":"after-hours/won.vrmxs"}},
    {"from":"rules","signal":"lost","to":"rules","call":"changeScene","args":{"after":3,"to":"after-hours/lost.vrmxs"}}
  ]
}
