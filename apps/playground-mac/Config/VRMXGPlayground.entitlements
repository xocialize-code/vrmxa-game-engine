<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The shell's sandbox (apps/shell): network.server for the loopback origin, user-selected files for the panels. -->
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.network.client</key><true/>
	<key>com.apple.security.network.server</key><true/>
	<key>com.apple.security.files.user-selected.read-write</key><true/>
	<!-- The camera (M3 W5): the shell's camera.* methods; frames stay in the shell, only feature numbers reach the page. -->
	<key>com.apple.security.device.camera</key><true/>
	<!-- The microphone (M3 W3): the page's getUserMedia (@vrmxg/voice microphone()) and the shell's microphone.* methods. -->
	<key>com.apple.security.device.audio-input</key><true/>
	<!-- The voice models' folder (M3 W3): picked once with voice.chooseModels and remembered as a security-scoped bookmark. -->
	<key>com.apple.security.files.bookmarks.app-scope</key><true/>
</dict>
</plist>
